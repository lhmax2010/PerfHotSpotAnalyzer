{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lhmax2010/PerfHotSpotAnalyzer/schemas/capture-bundle.schema.json",
  "title": "capture-bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "backend",
    "device",
    "capture_job",
    "target",
    "perf",
    "run_context",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "capture-bundle/v1"
    },
    "backend": {
      "enum": ["ssh", "sdb", "local"]
    },
    "device": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "arch"],
      "properties": {
        "name": {"type": "string"},
        "host": {"type": "string"},
        "arch": {"enum": ["armv7", "aarch64", "x86_64"]},
        "tizen_version": {"type": "string"}
      }
    },
    "capture_job": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["pid", "command", "service"]},
        "pid": {"type": ["integer", "null"], "minimum": 1},
        "cmdline": {"type": ["string", "null"]},
        "service": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "perf": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "events",
        "freq_hz",
        "callgraph_mode",
        "duration_s",
        "repeat",
        "warmup"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "freq_hz": {"type": "integer", "minimum": 1},
        "callgraph_mode": {"enum": ["fp", "dwarf", "none"]},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "repeat": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0}
      }
    },
    "run_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cpu_governor", "affinity", "thermal_state"],
      "properties": {
        "cpu_governor": {"type": "string"},
        "affinity": {"type": "string"},
        "thermal_state": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perf_data",
        "perf_script",
        "folded",
        "perf_report",
        "kallsyms",
        "proc_maps",
        "dso_list",
        "run_context",
        "exec_log"
      ],
      "properties": {
        "perf_data": {"type": "string", "minLength": 1},
        "perf_script": {"type": "string", "minLength": 1},
        "folded": {"type": "string", "minLength": 1},
        "perf_report": {"type": "string", "minLength": 1},
        "kallsyms": {"type": "string", "minLength": 1},
        "proc_maps": {"type": "string", "minLength": 1},
        "dso_list": {"type": "string", "minLength": 1},
        "run_context": {"type": "string", "minLength": 1},
        "exec_log": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by", "version", "timestamp"],
      "properties": {
        "generated_by": {"type": "string"},
        "version": {"type": "string"},
        "timestamp": {"type": "string"}
      }
    }
  }
}

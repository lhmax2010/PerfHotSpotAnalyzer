{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lhmax2010/PerfHotSpotAnalyzer/schemas/suggestion-patch.schema.json",
  "title": "suggestion-patch",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_reports",
    "patches",
    "apply_instructions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "source_format",
          "parser",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "source_format": {
            "type": "string"
          },
          "parser": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "apply_instructions": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generated_by",
        "version",
        "timestamp"
      ],
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "chosen_anchor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "anchor_confidence",
        "resolution_method"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "anchor_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resolution_method": {
          "enum": [
            "dwarf",
            "addr2line",
            "ctags",
            "compile-db",
            "grep",
            "bench-name-map",
            "llm"
          ]
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "idea",
        "risk"
      ],
      "properties": {
        "suggested_locations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idea": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string"
        }
      }
    },
    "files_touched_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "allowed",
        "reason",
        "risk"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        }
      }
    },
    "expected_impact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "level",
        "confidence"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "estimate": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "verification_plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "build_cmd": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_cmd": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_cmd": {
          "type": [
            "string",
            "null"
          ]
        },
        "manual_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "finding_id",
        "source_ref",
        "patch_category",
        "files_touched",
        "files_touched_policy",
        "expected_impact",
        "measured_impact",
        "side_effects",
        "risk",
        "rationale",
        "status",
        "validation_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "patch_category": {
          "enum": [
            "local-micro-optimization",
            "build-flag",
            "allocation-reduction",
            "algorithm-change",
            "concurrency-change",
            "api/semantic-change"
          ]
        },
        "strategy": {
          "type": "string"
        },
        "chosen_anchor": {
          "$ref": "#/$defs/chosen_anchor"
        },
        "diff": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "files_touched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_touched_policy": {
          "$ref": "#/$defs/files_touched_policy"
        },
        "expected_impact": {
          "$ref": "#/$defs/expected_impact"
        },
        "measured_impact": {
          "type": [
            "object",
            "null"
          ]
        },
        "side_effects": {
          "$ref": "#/$defs/side_effects"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "rationale": {
          "type": "string"
        },
        "verify_cmd": {
          "type": "string"
        },
        "verification_plan": {
          "$ref": "#/$defs/verification_plan"
        },
        "status": {
          "enum": [
            "diff-ready",
            "needs-review",
            "advisory-only"
          ]
        },
        "validation_status": {
          "enum": [
            "not-run",
            "build-pass",
            "test-pass",
            "benchmark-pass"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "advisory-only"
              }
            }
          },
          "then": {
            "required": [
              "recommendation"
            ],
            "not": {
              "required": [
                "diff"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "diff-ready",
                  "needs-review"
                ]
              }
            }
          },
          "then": {
            "required": [
              "diff",
              "chosen_anchor"
            ]
          }
        }
      ]
    }
  }
}
